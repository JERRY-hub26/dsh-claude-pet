{
  "name": "dsh-claude-pet",
  "version": "0.2.5",
  "type": "module",
  "engines": {
    "dsh": "^0.2.0"
  },
  "description": "A floating chibi study companion in the DSH Web GUI who blinks, watches you think, takes notes while the agent works, and stays on the desktop when the window is minimised.",
  "author": "JerryHui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JERRY-hub26/dsh-claude-pet.git"
  },
  "keywords": [
    "dsh-plugin",
    "desktop-pet",
    "companion"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./assets/*": "./assets/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "runtime/helper/index.html",
    "runtime/helper/lines.js",
    "runtime/helper/main.cjs",
    "runtime/helper/pet.css",
    "runtime/helper/pet.js",
    "runtime/helper/preload.cjs",
    "assets/idle-sheet.png",
    "assets/think.png",
    "assets/work.png",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "screenshots.json",
    "icon.png",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
